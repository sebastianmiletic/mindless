{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindless",
  "version": "0.1.0",
  "identifier": "com.mindless.focus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "Mindless",
      "width": 580,
      "height": 580,
      "minWidth": 580,
      "minHeight": 580,
      "maxWidth": 580,
      "maxHeight": 580,
      "center": true,
      "resizable": false,
      "fullscreen": false,
      "alwaysOnTop": true,
      "decorations": false,
      "transparent": true,
      "shadow": false,
      "visible": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Block distracting apps and websites for a fixed focus session",
    "longDescription": "Mindless creates fixed-duration focus sessions that block selected macOS applications and website domains.",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
